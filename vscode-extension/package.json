{
  "name": "ooumph-ai-chat",
  "displayName": "Ooumph AI Chat",
  "description": "Azure DeepSeek AI Chat assistant — use it as a sidebar panel in VS Code",
  "version": "1.0.0",
  "publisher": "ooumph",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["ai", "chat", "azure", "deepseek", "openai", "assistant"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ooumph.openChat",
        "title": "Ooumph: Open AI Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ooumph-sidebar",
          "title": "Ooumph AI Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ooumph-sidebar": [
        {
          "type": "webview",
          "id": "ooumph.chatView",
          "name": "Ooumph AI Chat"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "ooumph.openChat",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ooumph.openChat",
          "when": "view == ooumph.chatView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ooumph.openChat",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "Ooumph AI Chat",
      "properties": {
        "ooumph.azureEndpoint": {
          "type": "string",
          "default": "",
          "description": "Your Azure OpenAI endpoint (e.g. https://YOUR_RESOURCE.openai.azure.com)"
        },
        "ooumph.azureApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Azure OpenAI API key"
        },
        "ooumph.azureApiVersion": {
          "type": "string",
          "default": "2025-01-01-preview",
          "description": "Azure OpenAI API version"
        },
        "ooumph.models": {
          "type": "array",
          "default": ["DeepSeek-R1", "DeepSeek-V3", "gpt-4o"],
          "description": "List of Azure OpenAI deployment names to show in the model picker"
        },
        "ooumph.defaultModel": {
          "type": "string",
          "default": "DeepSeek-R1",
          "description": "Default model/deployment to use"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint",
    "lint": "eslint .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0",
    "@types/vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noreply-ooumph/ooumph_azure_deepseek_open.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://noreply-ooumph.github.io/ooumph_azure_deepseek_open/",
  "license": "MIT"
}

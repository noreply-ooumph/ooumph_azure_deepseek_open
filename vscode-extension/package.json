{
  "name": "ooumph-ai-chat",
  "displayName": "Ooumph AI Chat",
  "description": "Azure DeepSeek AI Chat — full VS Code workspace context like Claude Code",
  "version": "1.1.4",
  "publisher": "ooumph",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["AI", "Chat", "Other"],
  "keywords": ["ai", "chat", "azure", "deepseek", "openai", "assistant"],
  "activationEvents": [
    "onStartupFinished",
    "onView:ooumph.chatView",
    "onCommand:ooumph.openChat",
    "onCommand:ooumph.setCredentials",
    "onCommand:ooumph.refreshWorkspace"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "ooumph.openChat",         "title": "Ooumph: Open AI Chat",           "icon": "$(comment-discussion)" },
      { "command": "ooumph.setCredentials",   "title": "Ooumph: Set Azure Credentials"   },
      { "command": "ooumph.refreshWorkspace", "title": "Ooumph: Refresh Workspace Index" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "ooumph-sidebar", "title": "Ooumph AI Chat", "icon": "$(comment-discussion)" }
      ]
    },
    "views": {
      "ooumph-sidebar": [
        { "type": "webview", "id": "ooumph.chatView", "name": "Ooumph AI Chat" }
      ]
    },
    "menus": {
      "editor/context": [
        { "command": "ooumph.openChat", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "ooumph.openChat", "key": "ctrl+shift+alt+o", "mac": "cmd+shift+alt+o" }
    ]
  },
  "scripts": { "package": "vsce package" },
  "devDependencies": { "@vscode/vsce": "^2.24.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/noreply-ooumph/ooumph_azure_deepseek_open.git",
    "directory": "vscode-extension"
  },
  "license": "MIT"
}